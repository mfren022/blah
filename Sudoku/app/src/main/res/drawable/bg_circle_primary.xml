<?xml version="1.0" encoding="utf-8"?>
<!-- A round primary button: the one exception to square edges, for the game's pause control. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="oval">
                    <solid android:color="?attr/suLine" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/suAccent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
