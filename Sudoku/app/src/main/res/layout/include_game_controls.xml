<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.ultimatesudoku.app.ui.ToolButton
                android:id="@+id/tool_undo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:toolIcon="@drawable/ic_undo"
                app:toolLabel="@string/tool_undo" />

            <com.ultimatesudoku.app.ui.ToolButton
                android:id="@+id/tool_erase"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:toolIcon="@drawable/ic_erase"
                app:toolLabel="@string/tool_erase" />

            <!-- Pause sits in the middle as a large round button. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/pause"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle_primary"
                    android:contentDescription="@string/pause"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause"
                    android:tint="?attr/suOnAccent" />
            </FrameLayout>

            <com.ultimatesudoku.app.ui.ToolButton
                android:id="@+id/tool_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:toolIcon="@drawable/ic_pencil"
                app:toolLabel="@string/tool_notes" />

            <com.ultimatesudoku.app.ui.ToolButton
                android:id="@+id/tool_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:toolIcon="@drawable/ic_bulb"
                app:toolLabel="@string/tool_hint" />
        </LinearLayout>

        <com.ultimatesudoku.app.ui.NumberPadView
            android:id="@+id/numpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:columns="@integer/pad_columns" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hint_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/suAccent" />

            <TextView
                android:id="@+id/hint_title"
                style="@style/Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/suUserDigit" />

            <ImageButton
                android:id="@+id/hint_close"
                style="@style/IconButton"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="?attr/suInkMuted" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint_text"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hint_apply"
            style="@style/Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            android:text="@string/hint_apply" />
    </LinearLayout>
</FrameLayout>
