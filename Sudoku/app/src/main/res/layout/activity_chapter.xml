<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/suBg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- The chapter's picture as a lit grid of squares, under the status bar too. -->
        <com.ultimatesudoku.app.ui.SquareGlowView
            android:id="@+id/glow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <include layout="@layout/include_top_bar" />

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="@dimen/chapter_picture_space"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/kicker"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/suUserDigit" />

                <TextView
                    android:id="@+id/chapter_title"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/roboto_black"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.03"
                    android:lineSpacingMultiplier="0.95"
                    android:textAllCaps="true"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/story"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="?attr/suInkMuted" />

                <TextView
                    android:id="@+id/techniques"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="?attr/suInk"
                    android:textSize="11sp" />

                <com.ultimatesudoku.app.ui.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:text="@string/chapter_levels" />

                <TextView
                    android:id="@+id/summary"
                    style="@style/Text.Body.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <com.ultimatesudoku.app.ui.LevelMapView
                android:id="@+id/map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp" />

            <TextView
                style="@style/Text.Body.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/story_footnote" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
