<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for "Push to GitHub". -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DraftpadApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Draftpad">

        <!-- Rotating keeps the canvas, zoom and any stroke in progress: the view is resized in place. -->
        <activity
            android:name=".EditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a screenshot or photo to Draftpad to sketch over it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity android:name=".DraftsActivity" android:exported="false" />

        <!-- Serves exported PNG and SVG files to the apps they are shared with. -->
        <provider
            android:name=".ShareProvider"
            android:authorities="com.draftpad.app.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
