<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dialog_padding"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/dialog_padding"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/github_intro"
            android:textColor="@color/ink_muted"
            android:textSize="14sp" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/github_repo" />

        <EditText
            android:id="@+id/repo"
            style="@style/DialogField"
            android:hint="@string/github_repo_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/github_token" />

        <EditText
            android:id="@+id/token"
            style="@style/DialogField"
            android:fontFamily="monospace"
            android:hint="@string/github_token_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:id="@+id/create_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_title"
            android:fontFamily="sans-serif-medium"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/github_create_token"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/github_token_steps"
            android:textColor="@color/ink_muted"
            android:textSize="13sp" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/github_branch" />

        <EditText
            android:id="@+id/branch"
            style="@style/DialogField"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            style="@style/DialogLabel"
            android:text="@string/github_folder" />

        <EditText
            android:id="@+id/folder"
            style="@style/DialogField"
            android:hint="@string/github_folder_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
