<?xml version="1.0" encoding="utf-8"?>
<!-- Round touch feedback for the icon buttons in the bars. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pressed">
    <item android:id="@android:id/mask">
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <solid android:color="#FFFFFFFF" />
            </shape>
        </inset>
    </item>
</ripple>
