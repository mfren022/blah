<?xml version="1.0" encoding="utf-8"?>
<!-- Tool and width buttons: a soft accent tile while selected, ripple when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/pressed">
    <item android:id="@android:id/mask">
        <inset android:insetBottom="6dp" android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="6dp">
            <shape android:shape="rectangle">
                <corners android:radius="12dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </inset>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <inset android:insetBottom="6dp" android:insetLeft="2dp" android:insetRight="2dp" android:insetTop="6dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="12dp" />
                        <solid android:color="@color/accent_soft" />
                    </shape>
                </inset>
            </item>
        </selector>
    </item>
</ripple>
