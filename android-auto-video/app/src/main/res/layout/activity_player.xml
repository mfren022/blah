<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <io.github.mfren022.drivein.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </io.github.mfren022.drivein.AspectRatioFrameLayout>

    <ProgressBar
        android:id="@+id/buffering"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="120dp"
        android:background="@color/scrim"
        android:gravity="center"
        android:maxWidth="520dp"
        android:padding="16dp"
        android:textColor="@color/on_background"
        android:textSize="18sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/back"
                style="@style/DriveIn.IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/on_background"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/previous"
                style="@style/DriveIn.IconButton"
                android:contentDescription="@string/previous"
                android:src="@drawable/ic_skip_previous" />

            <ImageButton
                android:id="@+id/rewind"
                style="@style/DriveIn.IconButton"
                android:layout_marginStart="16dp"
                android:contentDescription="@string/rewind"
                android:src="@drawable/ic_rewind" />

            <ImageButton
                android:id="@+id/play_pause"
                style="@style/DriveIn.IconButton"
                android:layout_width="@dimen/touch_target_large"
                android:layout_height="@dimen/touch_target_large"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/pause"
                android:padding="22dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/background" />

            <ImageButton
                android:id="@+id/fast_forward"
                style="@style/DriveIn.IconButton"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/fast_forward"
                android:src="@drawable/ic_fast_forward" />

            <ImageButton
                android:id="@+id/next"
                style="@style/DriveIn.IconButton"
                android:contentDescription="@string/next"
                android:src="@drawable/ic_skip_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/gutter"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/gutter"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/on_background"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target"
                android:layout_weight="1"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/on_background"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
