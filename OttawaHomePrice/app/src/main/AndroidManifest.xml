<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used to look up typed addresses (the phone's geocoder, or OpenStreetMap's Nominatim). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No backups: recent searches (addresses) stay on the phone, as the How it works screen says. -->
    <application
        android:name=".HomePriceApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.HomePrice">

        <!-- The screen lays itself out again on rotation rather than restarting, so a search in
             flight, its suggestions and the map's zoom survive. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MethodologyActivity" android:exported="false" />
    </application>

</manifest>
